# Application Environment
APP_ENV=production
APP_NAME="Health and Safety Inventory"
APP_URL=https://your-domain.com/path
APP_DEBUG=false
APP_TIMEZONE=America/New_York

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_db
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

# Security Keys (Generate using: php generate-keys.php)
SECURE_AUTH_KEY=generate_unique_64_char_hex_string
SECURE_AUTH_SALT=generate_unique_64_char_hex_string

# Session Configuration
SESSION_NAME=h_s_inventory_session
SESSION_LIFETIME=604800
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE=true
SESSION_HTTPONLY=true

# File Upload Settings
MAX_FILE_SIZE=5242880
UPLOAD_PATH=/public/uploads/

# Feature Flags
ENABLE_PASSWORD_RESET=true
ENABLE_AUDIT_LOG=true
ENABLE_LDAP=false
ENABLE_TWO_FACTOR_AUTH=false

# LDAP Configuration (if ENABLE_LDAP=true)
LDAP_HOST=ad.example.com
LDAP_PORT=389
LDAP_DOMAIN=example.local
LDAP_BASE_DN="DC=example,DC=local"
LDAP_GROUP="Your Group Name"
LDAP_GROUP_DN="CN=Your Group,OU=Groups,DC=example,DC=local"

# Email Configuration
ADMIN_EMAIL=admin@example.com
SYSTEM_EMAIL=noreply@example.com

# Error Reporting (E_ALL, E_ERROR, E_WARNING, E_NOTICE, NONE)
ERROR_REPORTING=E_ERROR

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="The system is currently under maintenance. Please check back later."
