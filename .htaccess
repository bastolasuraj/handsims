# H&S Inventory v4 - Apache Rewrite Rules

# Enable the rewrite engine
RewriteEngine On

# Set the base path for the rewrite rules.
# If your application is in a subdirectory, e.g., http://domain.com/handsims/v4/
# set this to /handsims/v4/
# If it's at the root of a domain/subdomain, e.g., http://inventory.domain.com/
# you might be able to comment this out or set it to /
RewriteBase /handsims/v4/

# Rule 1: If the request is for an existing file (like a CSS or JS file), serve it directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Rule 2: If the request is not for an existing file, route it through index.php.
RewriteRule ^(.*)$ index.php [QSA,L]