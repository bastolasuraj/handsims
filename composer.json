{
    "name": "h_and_s/inventory_management",
    "description": "H&S Inventory Management System",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "endroid/qr-code": "^4.8",
        "picqer/php-barcode-generator": "^2.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "lint": "phpcs app/",
        "lint:fix": "phpcbf app/",
        "analyse": "phpstan analyse app/"
    }
}
